#include <iostream>

using namespace std;

int main() {
    int N = 0;
    int total = 0;
    do{
        cin >> N;
    }while(N < 3 || N > 500); //Teste pras condicoes
    
    int temp = 0;
    int sequencia[N];
    for (int i = 0; i < N;){
        cin >> temp;
        if(temp != 1 && temp !=2){
            cout << "\n";
        } else{
            sequencia[i] = temp;
            i++;
        }
    }
    
    temp = sequencia[0];
    total ++;
    
    for (int y = 1; y < N;y++){
        if(sequencia[y] != temp){
            total++;
        }
        temp = sequencia[y];
    }
    
    cout << total << "\n";
    
    return 0;
}
